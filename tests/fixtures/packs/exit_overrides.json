{
  "schema_version": 1,
  "id": "exit-overrides",
  "version": "1.0.0",
  "label": "Exit overrides",
  "author": "krellbot tests",
  "timeframe": "1h",
  "indicators": {
    "lowest10": {
      "fn": "lowest",
      "len": 5
    },
    "highest10": {
      "fn": "highest",
      "len": 5
    }
  },
  "entry": [
    "close",
    ">",
    "lowest10"
  ],
  "exit": [
    "lowest10",
    "<",
    "highest10"
  ],
  "risk": {
    "max_account_pct": 25,
    "stop": {
      "type": "pct",
      "pct": 5
    }
  },
  "markets": [
    {
      "venue": "kraken",
      "pair": "SUIUSD"
    }
  ]
}
